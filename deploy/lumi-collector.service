[Unit]
Description=LUMI handheld collector
After=lumi-splash.service
# Do not wait for Wi-Fi. The loading frame is already on the glass.

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/lumi
ExecStart=/home/pi/lumi/venv/bin/lumi-collector --config /home/pi/lumi/collector.yaml
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
